<Window x:Class="Relay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Relay" Width="1180" Height="800" MinWidth="720" MinHeight="540" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Base}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="CaptionBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,14,0">
            <Viewbox Width="15" Height="15"><Canvas Width="32" Height="32"><Path Stroke="{DynamicResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,21 L7,12 C7,3 25,3 25,12 C25,18 17,18 14,18 L24,27"/><Ellipse Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="26" Fill="{DynamicResource Accent}"/></Canvas></Viewbox>
          </StackPanel>
          <Grid Grid.Column="1" Margin="0,0,12,0">
            <TextBlock x:Name="CaptionContext" Text="sup, chungus" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ServiceIdentityButton" Visibility="Collapsed" Height="28" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="7,0" Click="ServiceAddressClick" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ServiceCaptionName" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ServiceCaptionHost" Grid.Column="1" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Muted}" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </Grid>
          <StackPanel x:Name="MediaControls" Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="MediaTitle" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" MaxWidth="220"/>
            <Button x:Name="MediaPreviousButton" Style="{StaticResource ServiceCaptionButton}" Content="&#xE892;" ToolTip="Previous" Click="MediaPreviousClick"/>
            <Button x:Name="MediaPlayButton" Style="{StaticResource ServiceCaptionButton}" Content="&#xE769;" ToolTip="Pause" Click="MediaPlayClick" Foreground="{DynamicResource Accent}"/>
            <Button x:Name="MediaNextButton" Style="{StaticResource ServiceCaptionButton}" Content="&#xE893;" ToolTip="Next" Click="MediaNextClick"/>
          </StackPanel>
              <Grid x:Name="CaptionActions" Grid.Column="3" Margin="8,0,12,0" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel x:Name="BrowserTools" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource ServiceCaptionButton}" Content="&#xE72B;" ToolTip="Back" Click="BackClick"/>
                <Button Style="{StaticResource ServiceCaptionButton}" Content="&#xE72C;" ToolTip="Reload" Click="ReloadClick"/>
                <Button Style="{StaticResource ServiceCaptionButton}" Content="&#xE80F;" ToolTip="Service home" Click="HomeClick"/>
                <Border Width="1" Height="16" Background="{DynamicResource Line}" Margin="5,0"/>
                <Button Style="{StaticResource ServiceCaptionButton}" Content="&#xE8A7;" ToolTip="Open externally" Click="ExternalClick"/>
              </StackPanel><Button x:Name="BrowserOverflow" Style="{StaticResource ServiceCaptionButton}" Content="&#xE712;" ToolTip="Navigation" Visibility="Collapsed" Click="BrowserOverflowClick"/></Grid>
          <StackPanel x:Name="WindowButtons" Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeClick"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore" Click="MaximizeClick"/>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseClick"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="Workspace" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition x:Name="TopRailRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DownloadsColumn" Width="0"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarFrame" Grid.RowSpan="2" ContextMenuOpening="SidebarContextMenuOpening" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Background="{DynamicResource Panel}">
          <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
          <DockPanel x:Name="SidebarContent" Margin="7,12">
            <StackPanel x:Name="SidebarUtilities" DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
              <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" ToolTip="Compact sidebar" AutomationProperties.Name="Compact sidebar" Click="SidebarToggleClick" Width="46" Height="30" Content="&#xE76B;"/>
              <StackPanel x:Name="SidebarUtilityItems">
              <Border x:Name="UsageHover" Width="46" Height="30" Background="Transparent" Margin="0,4" AutomationProperties.Name="Resource usage" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Right">
                <Viewbox Width="17" Height="17"><Canvas Width="20" Height="20"><Path x:Name="UsageIndicator" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 2,10 L 5,10 L 8,4 L 12,16 L 15,10 L 18,10"/></Canvas></Viewbox>
                <Border.ToolTip>
                  <ToolTip x:Name="UsageDetails" Placement="Right" HorizontalOffset="8" Padding="12,9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,24,6"/>
                      <TextBlock x:Name="CpuUsageDetail" Grid.Column="1" Text="…" FontSize="11" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Row="1" Text="Memory" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,24,0"/>
                      <TextBlock x:Name="RamUsageDetail" Grid.Row="1" Grid.Column="1" Text="…" FontSize="11" HorizontalAlignment="Right"/>
                      <TextBlock x:Name="TopCpuText" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="10" Margin="0,8,0,0" MaxWidth="230" TextWrapping="Wrap"/>
                      <TextBlock x:Name="TopMemoryText" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="10" Margin="0,8,0,0" MaxWidth="230" TextWrapping="Wrap"/>
                    </Grid>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
              <Button x:Name="UpdateButton" Style="{StaticResource IconButton}" Visibility="Collapsed" ToolTip="Restart to update" AutomationProperties.Name="Restart to update" Click="UpdateClick" Width="46" Height="30" Content="&#xE777;" Foreground="{DynamicResource Accent}"/>
              <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" ToolTip="Downloads" AutomationProperties.Name="Downloads" Click="DownloadsClick" Width="46" Height="38" Content="&#xE896;"/>
              <ToggleButton x:Name="QuietButton" Style="{StaticResource QuietToggle}" ToolTip="Mute notifications" AutomationProperties.Name="Mute notifications" Checked="QuietChanged" Unchecked="QuietChanged" Width="46" Height="38"/>
              <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsClick" Width="46" Height="38" Content="&#xE713;"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="SidebarHeading" DockPanel.Dock="Top">
              <Button x:Name="ActivityButton" Style="{StaticResource IconButton}" ToolTip="Activity" AutomationProperties.Name="Activity" Click="ActivityClick" Width="46" Height="42" Content="&#xE8F2;"/>
              <Border x:Name="SidebarDivider" Height="1" Background="{DynamicResource Line}" Margin="10,12"/>
            </StackPanel>
            <ScrollViewer x:Name="ServiceRailScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ServiceRail"/></ScrollViewer>
          </DockPanel>
        </Border>
        <Grid x:Name="WorkspaceContent" Grid.Column="1" Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition x:Name="PageHeaderRow" Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="PageHeader" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0,18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageHeading" Text="Activity" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="The gang's nonsense, centralized" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>

            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid x:Name="WebHost" Visibility="Collapsed"/>
            <ScrollViewer x:Name="LocalPage" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LocalContent" Margin="28,26,28,32" MaxWidth="920" HorizontalAlignment="Stretch"/></ScrollViewer>
            <Border x:Name="ErrorPanel" Background="{DynamicResource Base}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="30"><TextBlock x:Name="ErrorHeading" Text="This one fell over." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><Button Content="Try again" Click="ReloadClick" HorizontalAlignment="Left" Margin="0,20,0,0" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource Accent}"/></StackPanel></Border>
          </Grid>
        </Grid>
        <Border x:Name="DownloadsPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
          <DockPanel Margin="14,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close downloads" Click="DownloadsClick"/>
              <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="8,4" Click="ClearDownloadsClick"/>
              <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DownloadItems"/></ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
